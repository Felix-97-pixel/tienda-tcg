generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cardDetails           CardDetail[]
  expansions            Expansion[]
  finishes              Finish[]
  stores                Store[]                     @relation("StoreGames")
  storeExchangeRates    StoreGameExchangeRate[]
  globalExchangeRates   GlobalGameExchangeRate[]
  coupons               Coupon[]                    @relation("CouponGames")
  conditionDevaluations StoreConditionDevaluation[]
  languageDevaluations  StoreLanguageDevaluation[]
}

model Category {
  id             String    @id @default(uuid())
  name           String    @unique
  slug           String    @unique
  imageUrl       String?
  isTcg          Boolean   @default(false)
  commissionRate Decimal?  @db.Decimal(5, 4) // Comisión especial por categoría (ej: 0.0500 = 5%), opcional
  products       Product[]
  coupons        Coupon[]  @relation("CouponCategories")
}

model Brand {
  id       String    @id @default(uuid())
  name     String    @unique
  imageUrl String?
  products Product[]
}

model Product {
  id           String          @id @default(uuid())
  slug         String?         @unique
  externalId   String?         @unique // Opcional para custom products
  name         String
  description  String?
  imageUrl     String?
  categoryId   String
  brandId      String?
  storeId      String? // NULL = Global, con ID = Custom de tienda
  isDeleted    Boolean         @default(false)
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  cardDetail   CardDetail?
  weightGram   Float?
  widthCm      Float?
  heightCm     Float?
  lengthCm     Float?
  items        InventoryItem[]
  marketPrices MarketPrice[]
  category     Category        @relation(fields: [categoryId], references: [id])
  brand        Brand?          @relation(fields: [brandId], references: [id])
  store        Store?          @relation("StoreCustomProducts", fields: [storeId], references: [id])
  wishlistedBy WishlistItem[]
  buyListItems BuyListItem[]
  barcode      String?
  sku          String?

  @@index([name])
  @@index([categoryId])
  @@index([storeId])
  @@index([barcode])
}

model Language {
  id                   String                     @id @default(uuid())
  name                 String                     @unique // e.g., "Spanish", "English"
  code                 String                     @unique // e.g., "es", "en"
  items                InventoryItem[]
  buyListItems         BuyListItem[]
  languageDevaluations StoreLanguageDevaluation[]
}

model Condition {
  id           String                      @id @default(uuid())
  name         String                      @unique // e.g., "near_mint", "poor"
  displayName  String?
  items        InventoryItem[]
  devaluations StoreConditionDevaluation[]
  buyListItems BuyListItem[]
}

model CardDetail {
  id           String   @id @default(uuid())
  expansion    String
  rarity       String
  collectorNum String
  attributes   String[] @default([])
  productId    String   @unique
  product      Product  @relation(fields: [productId], references: [id])

  expansionId  String?
  expansionRel Expansion? @relation(fields: [expansionId], references: [id])

  gameId  String
  gameRel Game   @relation(fields: [gameId], references: [id])

  @@index([expansion])
  @@index([productId])
}

model Expansion {
  id          String    @id @default(uuid())
  externalId  String?
  name        String
  releaseDate DateTime?
  imageUrl    String?

  gameId  String
  gameRel Game   @relation(fields: [gameId], references: [id])

  cardDetails CardDetail[]

  @@unique([externalId, gameId])
}

model InventoryItem {
  id            String             @id @default(uuid())
  storeId       String?
  productId     String
  conditionId   String
  languageId    String
  finishId      String?
  price         Decimal            @db.Decimal(10, 2)
  stock         Int                @default(0)
  reservedStock Int                @default(0)
  isPublished   Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  store         Store?             @relation(fields: [storeId], references: [id])
  product       Product            @relation(fields: [productId], references: [id])
  condition     Condition          @relation(fields: [conditionId], references: [id])
  language      Language           @relation(fields: [languageId], references: [id])
  finish        Finish?            @relation(fields: [finishId], references: [id])
  reservations  StockReservation[]

  @@index([storeId])
  @@index([productId])
  @@index([storeId, productId])
  @@index([isPublished, stock])
  @@index([storeId, isPublished, stock])
  @@index([productId, isPublished, stock])
}

model StockReservation {
  id              String   @id @default(uuid())
  inventoryItemId String
  orderId         String
  quantity        Int
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Finish {
  id      String          @id @default(uuid())
  name    String
  aliases String[]        @default([])
  items   InventoryItem[]

  gameId       String
  gameRel      Game          @relation(fields: [gameId], references: [id])
  marketPrices MarketPrice[]

  @@unique([name, gameId])
}

model MarketPrice {
  id        String   @id @default(uuid())
  productId String
  finishId  String?
  price     Decimal  @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  finish  Finish?              @relation(fields: [finishId], references: [id], onDelete: Cascade)
  history MarketPriceHistory[]

  @@unique([productId, finishId])
}

model MarketPriceHistory {
  id            String   @id @default(uuid())
  marketPriceId String
  price         Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  marketPrice MarketPrice @relation(fields: [marketPriceId], references: [id], onDelete: Cascade)

  @@index([marketPriceId])
  @@index([createdAt])
}

model Company {
  id                 String   @id @default(uuid())
  name               String
  rut                String?
  legalName          String?
  fantasyName        String?
  taxActivity        String?
  taxAddress         String?
  taxCommune         String?
  taxRegion          String?
  taxClassification  String   @default("PRIMERA_CATEGORIA_AFECTO") // "PRIMERA_CATEGORIA_AFECTO" | "PRIMERA_CATEGORIA_EXENTO"
  siiActivityStarted Boolean  @default(true)
  dteEmail           String?
  verificationStatus String   @default("ENABLED") // "PENDING_VERIFICATION" | "PENDING_DOCS" | "ENABLED" | "SUSPENDED" | "BLOCKED"
  verifiedAt         DateTime?
  verifiedByUserId   String?
  mandateAcceptedAt  DateTime?
  mandateContractUrl String?
  customCommissionRate Decimal? @db.Decimal(5, 4) // Excepción comercial de comisión al vendedor (ej: 0.0500 = 5%)
  commissionCalcBase String   @default("NET") // "NET" | "GROSS"
  bankName           String?
  bankAccountType    String?  // "CUENTA_CORRIENTE" | "CUENTA_VISTA" | "CUENTA_RUT"
  bankAccountNumber  String?
  bankHolderRut      String?
  bankHolderName     String?
  bankEmail          String?
  bankUpdatedAt      DateTime?
  logoUrl            String?
  ownerId            String
  planId             String?
  balance            Decimal  @default(0) @db.Decimal(10, 2)
  extraBranchesCount Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner   User              @relation(fields: [ownerId], references: [id])
  plan    SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  stores  Store[]
  members CompanyMember[]

  @@index([ownerId])
  @@index([rut])
  @@index([verificationStatus])
}

model CompanyMember {
  id        String      @id @default(uuid())
  companyId String
  userId    String
  role      CompanyRole @default(OWNER)
  createdAt DateTime    @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}


model Store {
  id                   String                      @id @default(uuid())
  companyId            String?
  isMainBranch         Boolean                     @default(true)
  ownerId              String
  name                 String
  subdomain            String                      @unique
  customDomain         String?                     @unique
  logoUrl              String?
  address              String?
  latitude             Float?
  longitude            Float?
  pickupEnabled        Boolean                     @default(false)
  pickupAddress        String?
  pickupSchedule       String?
  originRegionId       String?
  originRegion         Region?                     @relation(fields: [originRegionId], references: [id], onDelete: SetNull)
  originCommuneId      String?
  originCommune        Commune?                    @relation(fields: [originCommuneId], references: [id], onDelete: SetNull)
  supportedGames       Game[]                      @relation("StoreGames")
  balance              Decimal                     @default(0) @db.Decimal(10, 2)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  company              Company?                    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner                User                        @relation(fields: [ownerId], references: [id])
  inventory            InventoryItem[]
  customProducts       Product[]                   @relation("StoreCustomProducts")
  vendorOrders         VendorOrder[]
  shipping             ShippingProvider[]
  settings             StoreSetting[]
  transactions         WalletTransaction[]
  withdrawals          WithdrawalRequest[]
  devaluations         StoreConditionDevaluation[]
  languageDevaluations StoreLanguageDevaluation[]
  gameExchangeRates    StoreGameExchangeRate[]

  subscriptionPlans SubscriptionPlan[] @relation("StoreSubscriptionPlans")

  subscriptionDiscountType  String? @default("NONE") // "NONE" | "PERCENTAGE" | "FIXED_AMOUNT"
  subscriptionDiscountValue Decimal @default(0) @db.Decimal(10, 2)
  subscriptionNotes         String?

  buyListItems       BuyListItem[]
  storeCredits       StoreCredit[]
  creditTransactions StoreCreditTransaction[]
  coupons            Coupon[]
  cashShifts         CashShift[]
  cashPurchases      CashPurchase[]
  members            StoreMember[]
}

model StoreMember {
  id        String    @id @default(uuid())
  storeId   String
  userId    String
  role      StoreRole @default(CASHIER)
  createdAt DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([storeId])
  @@index([userId])
}


model User {
  id                 String                   @id @default(uuid())
  email              String                   @unique
  password           String?
  googleId           String?                  @unique
  avatar             String?
  name               String?
  phone              String?
  address            String?
  city               String?
  lat                Float?
  lng                Float?
  regionCode         String?
  cityCode           String?
  role               Role                     @default(USER)
  isVerified         Boolean                  @default(false)
  verificationToken  String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  stores             Store[]
  companies          Company[]
  wishlist           WishlistItem[]
  orders             Order[]
  storeCredits       StoreCredit[]
  creditTransactions StoreCreditTransaction[]
  addresses          Address[]
  cashPurchases      CashPurchase[]
  companyMemberships CompanyMember[]
  storeMemberships   StoreMember[]
  uploadedEvidences  DispatchEvidence[] @relation("UploadedEvidences")
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alias      String?  // Ej: "Casa", "Oficina", "Sucursal Starken"
  name       String   // Nombre destinatario
  phone      String   // Teléfono de contacto
  address    String   // Calle, número, depto
  city       String   // Comuna (ej: "Rancagua")
  cityCode   String   // Código comuna Chilexpress/Starken (ej: "RANCAGUA")
  regionCode String   // Código región (ej: "VI")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}


model ShippingLabel {
  id             String   @id @default(uuid())
  orderId        String   @unique
  provider       String // "STARKEN" | "CHILEXPRESS"
  trackingNumber String
  pdfUrl         String
  cost           Float
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Order {
  id            String             @id @default(uuid())
  buyOrder      String             @unique
  userId        String?
  email         String
  name          String
  phone         String?
  address       String?
  city          String?
  lat           Float?
  lng           Float?
  regionCode    String?
  cityCode      String?
  notes         String?
  totalAmount   Decimal            @db.Decimal(10, 2)
  // Desglose tributario y comisiones de plataforma (Normativa SII)
  productsTotal         Decimal           @default(0) @db.Decimal(10, 2)
  shippingTotal         Decimal           @default(0) @db.Decimal(10, 2)
  serviceFeeGross       Decimal           @default(0) @db.Decimal(10, 2)
  serviceFeeNet         Decimal           @default(0) @db.Decimal(10, 2)
  serviceFeeVat         Decimal           @default(0) @db.Decimal(10, 2)
  sellerCommissionNet   Decimal           @default(0) @db.Decimal(10, 2)
  sellerCommissionVat   Decimal           @default(0) @db.Decimal(10, 2)
  sellerCommissionGross Decimal           @default(0) @db.Decimal(10, 2)
  transbankFeeEstimate  Decimal           @default(0) @db.Decimal(10, 2)
  vatRateSnapshot       Decimal           @default(0.19) @db.Decimal(5, 4)
  currencyCode  String?            @default("CLP")
  exchangeRate  Decimal?           @db.Decimal(10, 2)
  status        OrderStatus        @default(PENDING)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  payment       Payment?
  shippingLabel ShippingLabel?
  user          User?              @relation(fields: [userId], references: [id])
  vendorOrders  VendorOrder[]
  reservations  StockReservation[]
  transactions  WalletTransaction[]
  origin           OrderOrigin       @default(ONLINE_MARKETPLACE)
  posPaymentMethod PosPaymentMethod?
  posVoucherRef    String?
  posCashierName   String?
  cashShiftId      String?
  cashShift        CashShift?        @relation(fields: [cashShiftId], references: [id])
  isOfflineSync    Boolean           @default(false)
  offlineCreatedAt DateTime?
}

model VendorOrder {
  id                    String             @id @default(uuid())
  orderId               String
  storeId               String
  shippingProviderId    String?
  shippingCost          Decimal            @default(0) @db.Decimal(10, 2)
  subtotal              Decimal            @default(0) @db.Decimal(10, 2)
  // Desglose fiscal y comisiones por tienda (Normativa SII)
  vatRate               Decimal            @default(0.19) @db.Decimal(5, 4)
  taxableNet            Decimal            @default(0) @db.Decimal(10, 2)
  vatAmount             Decimal            @default(0) @db.Decimal(10, 2)
  commissionRateApplied Decimal            @default(0) @db.Decimal(5, 4)
  commissionCalcBase    String             @default("NET") // "NET" | "GROSS"
  sellerCommissionNet   Decimal            @default(0) @db.Decimal(10, 2)
  sellerCommissionVat   Decimal            @default(0) @db.Decimal(10, 2)
  sellerCommissionGross Decimal            @default(0) @db.Decimal(10, 2)
  sellerNetPayout       Decimal            @default(0) @db.Decimal(10, 2)
  settlementStatus      String             @default("HELD_ESCROW") // "HELD_ESCROW" | "AVAILABLE" | "LOCKED_IN_SETTLEMENT" | "SETTLED" | "REFUNDED" | "DISPUTED"
  buyerDteType          Int?               // 39 (Boleta Afecta), 41 (Boleta Exenta), 33 (Factura Afecta)
  buyerDteFolio         String?
  buyerDteUrl           String?
  withdrawalRequestId   String?
  sellerRut             String?
  sellerLegalName       String?
  status                OrderStatus        @default(PENDING)
  deliveryStatus        String?            @default("PENDING_DISPATCH")
  shippingCourier       String?
  trackingNumber        String?
  trackingUrl           String?
  dispatchedAt          DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  order                 Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store                 Store              @relation(fields: [storeId], references: [id])
  shippingProvider      ShippingProvider?  @relation(fields: [shippingProviderId], references: [id])
  withdrawalRequest     WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  evidence              DispatchEvidence?
  transactions          WalletTransaction[]

  @@index([storeId, settlementStatus])
  @@index([withdrawalRequestId])
}

model DispatchEvidence {
  id                 String       @id @default(uuid())
  vendorOrderId      String       @unique
  contentPhotoUrl    String
  packagingPhotoUrl  String
  packagePhotoUrl    String
  capturedAt         DateTime     @default(now())
  uploaderUserId     String?
  lifecycleExpiresAt DateTime?

  vendorOrder        VendorOrder  @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  uploader           User?        @relation("UploadedEvidences", fields: [uploaderUserId], references: [id], onDelete: SetNull)

  @@index([vendorOrderId])
}

model OrderItem {
  id              String      @id @default(uuid())
  vendorOrderId   String
  productId       String
  inventoryItemId String?
  productName     String
  quantity        Int
  unitPrice       Decimal     @db.Decimal(10, 2)
  vendorOrder     VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @unique
  token           String        @unique
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(10, 2)
  authCode        String?
  cardLast4       String?
  paymentType     String?
  installments    Int?
  transactionDate DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order         @relation(fields: [orderId], references: [id])
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum CompanyRole {
  OWNER
  ADMIN
  ACCOUNTANT
}

enum StoreRole {
  BRANCH_MANAGER
  CASHIER
}


enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  FAILED
  NULLIFIED
}

enum OrderOrigin {
  ONLINE_MARKETPLACE
  POS_IN_STORE
}

enum PosPaymentMethod {
  CASH
  CARD_POS
  TRANSFER
  STORE_CREDIT
  MIXED
}

model GlobalSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model Currency {
  id           String   @id @default(uuid())
  code         String   @unique // e.g., "CLP", "USD"
  name         String // e.g., "Peso Chileno"
  symbol       String // e.g., "$"
  exchangeRate Decimal  @db.Decimal(10, 2)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  globalExchangeRates GlobalGameExchangeRate[]
}

model StoreConditionDevaluation {
  id          String  @id @default(uuid())
  storeId     String
  conditionId String
  gameId      String
  multiplier  Decimal @db.Decimal(5, 4) // e.g. 0.8000

  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  condition Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([storeId, conditionId, gameId])
}

model StoreLanguageDevaluation {
  id         String  @id @default(uuid())
  storeId    String
  languageId String
  gameId     String
  multiplier Decimal @db.Decimal(5, 4) // e.g. 0.9500

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([storeId, languageId, gameId])
}

model ShippingProvider {
  id           String        @id @default(uuid())
  storeId      String?
  name         String // e.g. "CHILEXPRESS", "STARKEN"
  price        Decimal       @db.Decimal(10, 2)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  store        Store?        @relation(fields: [storeId], references: [id])
  vendorOrders VendorOrder[]

  @@unique([name, storeId])
}

model StoreSetting {
  id      String @id @default(uuid())
  storeId String
  key     String
  value   String
  store   Store  @relation(fields: [storeId], references: [id])

  @@unique([key, storeId])
}

model WalletTransaction {
  id                    String             @id @default(uuid())
  storeId               String
  orderId               String?
  vendorOrderId         String?
  withdrawalRequestId   String?
  parentTransactionId   String?
  amount                Decimal            @db.Decimal(10, 2)
  netAmount             Decimal?           @db.Decimal(10, 2)
  vatAmount             Decimal?           @db.Decimal(10, 2)
  type                  TransactionType
  direction             String             @default("CREDIT") // "CREDIT" | "DEBIT"
  bucket                String             @default("ESCROW") // "ESCROW" | "AVAILABLE" | "SETTLED" | "PLATFORM_REVENUE" | "GATEWAY_COST"
  status                String             @default("POSTED") // "POSTED" | "REVERSED"
  balanceAfterEscrow    Decimal            @default(0) @db.Decimal(10, 2)
  balanceAfterAvailable Decimal            @default(0) @db.Decimal(10, 2)
  paymentMethod         String             @default("WEBPAY")
  isWithdrawable        Boolean            @default(true)
  reference             String?
  idempotencyKey        String?
  createdByUserId       String?
  metadata              Json?
  effectiveAt           DateTime           @default(now())
  createdAt             DateTime           @default(now())
  store                 Store              @relation(fields: [storeId], references: [id])
  order                 Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  vendorOrder           VendorOrder?       @relation(fields: [vendorOrderId], references: [id], onDelete: SetNull)
  withdrawalRequest     WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([vendorOrderId])
  @@index([withdrawalRequestId])
  @@index([idempotencyKey])
}

enum TransactionType {
  SALE
  ESCROW_RELEASE
  COMMISSION
  WITHDRAWAL
  WITHDRAWAL_REVERSAL
  REFUND
  CHARGEBACK
  ADJUSTMENT
}

model WithdrawalRequest {
  id                    String              @id @default(uuid())
  settlementCode        String?
  storeId               String
  grossSalesAmount      Decimal             @default(0) @db.Decimal(10, 2)
  sellerCommissionNet   Decimal             @default(0) @db.Decimal(10, 2)
  sellerCommissionVat   Decimal             @default(0) @db.Decimal(10, 2)
  sellerCommissionGross Decimal             @default(0) @db.Decimal(10, 2)
  adjustmentsAmount     Decimal             @default(0) @db.Decimal(10, 2)
  amount                Decimal             @db.Decimal(10, 2) // Monto líquido final a transferir a la tienda
  status                WithdrawalStatus    @default(PENDING)
  bankDetails           String?
  bankSnapshot          Json?
  platformDteType       Int?                // Ej: 33 (Factura Electrónica TapTrade por comisión)
  platformDteFolio      String?
  platformDteUrl        String?
  storeDteType          Int?                // Ej: 33, 34 o 999 (Acta de Rendición de Mandato / DTE respaldo tienda)
  storeDteFolio         String?
  storeDteUrl           String?
  transferReference     String?
  transferReceiptUrl    String?
  processedByUserId     String?
  processedAt           DateTime?
  rejectionReason       String?
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  store                 Store               @relation(fields: [storeId], references: [id])
  vendorOrders          VendorOrder[]
  transactions          WalletTransaction[]

  @@index([storeId, status])
  @@index([settlementCode])
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  FAILED
}

model SyncBackup {
  id        String   @id @default(uuid())
  game      String
  filename  String
  csvData   String
  createdAt DateTime @default(now())
}


model SubscriptionPlan {
  id             String  @id @default(uuid())
  name           String  @unique
  description    String?
  price          Decimal @default(0) @db.Decimal(10, 2)
  skuLimit       Int     @default(-1)
  commissionRate Decimal @default(0) @db.Decimal(5, 4)
  isStandard     Boolean @default(true)

  stores    Store[]   @relation("StoreSubscriptionPlans")
  companies Company[]
}

model BuyListItem {
  id             String   @id @default(uuid())
  storeId        String
  productId      String
  conditionId    String
  languageId     String
  quantityWanted Int      @default(1)
  cashPrice      Decimal  @default(0) @db.Decimal(10, 2)
  creditPrice    Decimal  @default(0) @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  condition Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  language  Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId, conditionId, languageId])
}

model StoreCredit {
  id        String   @id @default(uuid())
  storeId   String
  userId    String
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
}

model StoreCreditTransaction {
  id        String   @id @default(uuid())
  storeId   String
  userId    String
  amount    Decimal  @db.Decimal(10, 2)
  type      String // e.g. "BUYLIST_TRADE", "MANUAL_ADD", "MANUAL_SUBTRACT", "PURCHASE"
  reference String?
  itemsData Json?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StoreGameExchangeRate {
  id               String   @id @default(uuid())
  storeId          String
  gameId           String
  rate             Decimal  @db.Decimal(10, 2)
  buyPercentage    Decimal  @default(50.00) @db.Decimal(5, 2) // % Pagado en Efectivo / Cash al comprar cartas (Trade-in)
  creditPercentage Decimal  @default(70.00) @db.Decimal(5, 2) // % Pagado en Crédito de Tienda al comprar cartas (Trade-in)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  game  Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([storeId, gameId])
}

model GlobalGameExchangeRate {
  id               String   @id @default(uuid())
  gameId           String
  currencyCode     String
  rate             Decimal  @db.Decimal(10, 2)
  buyPercentage    Decimal  @default(50.00) @db.Decimal(5, 2) // % Global en Efectivo para Trade-in
  creditPercentage Decimal  @default(70.00) @db.Decimal(5, 2) // % Global en Crédito para Trade-in
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyCode], references: [code], onDelete: Cascade, onUpdate: Cascade)

  @@unique([gameId, currencyCode])
}

enum CouponScope {
  STORE_WIDE
  CATEGORY_SPECIFIC
  GAME_SPECIFIC
}

model Coupon {
  id              String   @id @default(uuid())
  code            String   @unique
  discountPercent Float
  validFrom       DateTime
  validUntil      DateTime
  isActive        Boolean  @default(true)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  scope CouponScope @default(STORE_WIDE)

  categories Category[] @relation("CouponCategories")
  games      Game[]     @relation("CouponGames")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

model LogisticZone {
  id          String    @id @default(uuid())
  code        String    @unique // e.g. "RM", "NORTE_GRANDE", "NORTE_CHICO", "CENTRO", "SUR", "EXTREMO_SUR", "INSULAR"
  name        String // e.g. "Región Metropolitana", "Zona Norte Grande", "Zona Extrema Sur"
  description String?
  isActive    Boolean   @default(true)
  regions     Region[]
  communes    Commune[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([code])
}

model Region {
  id        String        @id @default(uuid())
  code      String        @unique // e.g. "RM", "V", "VIII", "XV"
  name      String // e.g. "Región Metropolitana de Santiago"
  shortName String? // e.g. "Metropolitana"
  zoneId    String?
  zone      LogisticZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  ordinal   Int           @default(0) // orden de norte a sur (1..16)
  isActive  Boolean       @default(true)
  communes  Commune[]
  stores    Store[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([code])
  @@index([zoneId])
}

model Commune {
  id        String        @id @default(uuid())
  code      String        @unique // e.g. "SANTIAGO", "PROVIDENCIA", "VALPARAISO"
  name      String // e.g. "Santiago Centro", "Providencia"
  regionId  String
  region    Region        @relation(fields: [regionId], references: [id], onDelete: Cascade)
  zoneId    String?
  zone      LogisticZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  isActive  Boolean       @default(true)
  stores    Store[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([regionId])
  @@index([zoneId])
  @@index([code])
}

model CashShift {
  id            String    @id @default(uuid())
  storeId       String
  cashierName   String
  status        String    @default("OPEN") // "OPEN" | "CLOSED"
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  initialCash   Decimal   @db.Decimal(10, 2)
  expectedCash  Decimal?  @db.Decimal(10, 2)
  actualCash    Decimal?  @db.Decimal(10, 2)
  cardTotal     Decimal   @default(0) @db.Decimal(10, 2)
  transferTotal Decimal   @default(0) @db.Decimal(10, 2)
  creditTotal   Decimal   @default(0) @db.Decimal(10, 2)
  cashOutTotal  Decimal   @default(0) @db.Decimal(10, 2)
  difference    Decimal?  @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  store         Store          @relation(fields: [storeId], references: [id])
  orders        Order[]
  cashPurchases CashPurchase[]
  @@index([storeId, status])
}

model CashPurchase {
  id            String     @id @default(uuid())
  code          String     @unique
  storeId       String
  userId        String?
  customerName  String?
  customerEmail String?
  customerRut   String?
  totalAmount   Decimal    @db.Decimal(10, 2)
  cashierName   String
  cashShiftId   String?
  itemsData     Json
  notes         String?
  createdAt     DateTime   @default(now())

  store         Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  cashShift     CashShift? @relation(fields: [cashShiftId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([cashShiftId])
}
