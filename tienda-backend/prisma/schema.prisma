generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  imageUrl String?
  isTcg    Boolean   @default(false)
  products Product[]
}

model Brand {
  id       String    @id @default(uuid())
  name     String    @unique
  imageUrl String?
  products Product[]
}

model Product {
  id           String          @id @default(uuid())
  externalId   String?         @unique // Opcional para custom products
  name         String
  description  String?
  imageUrl     String?
  categoryId   String
  brandId      String?
  storeId      String? // NULL = Global, con ID = Custom de tienda
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  cardDetail   CardDetail?
  items        InventoryItem[]
  category     Category        @relation(fields: [categoryId], references: [id])
  brand        Brand?          @relation(fields: [brandId], references: [id])
  store        Store?          @relation("StoreCustomProducts", fields: [storeId], references: [id])
  wishlistedBy WishlistItem[]
}

model Language {
  id    String          @id @default(uuid())
  name  String          @unique // e.g., "Spanish", "English"
  code  String          @unique // e.g., "es", "en"
  items InventoryItem[]
}

model Condition {
  id    String          @id @default(uuid())
  name  String          @unique // e.g., "near_mint", "poor"
  items InventoryItem[]
}

model CardDetail {
  id           String   @id @default(uuid())
  expansion    String
  rarity       String
  collectorNum String
  game         String
  attributes   String[] @default([])
  productId    String   @unique
  product      Product  @relation(fields: [productId], references: [id])
}

model InventoryItem {
  id          String    @id @default(uuid())
  storeId     String?
  productId   String
  conditionId String
  languageId  String
  finishId    String?
  price       Decimal   @db.Decimal(10, 2)
  stock       Int       @default(0)
  store       Store?    @relation(fields: [storeId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  condition   Condition @relation(fields: [conditionId], references: [id])
  language    Language  @relation(fields: [languageId], references: [id])
  finish      Finish?   @relation(fields: [finishId], references: [id])
}

model Finish {
  id      String          @id @default(uuid())
  name    String
  game    String
  aliases String[]        @default([])
  items   InventoryItem[]

  @@unique([name, game])
}

model Store {
  id             String              @id @default(uuid())
  ownerId        String              @unique
  name           String
  subdomain      String              @unique
  customDomain   String?             @unique
  logoUrl        String?
  balance        Decimal             @default(0) @db.Decimal(10, 2)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  owner          User                @relation(fields: [ownerId], references: [id])
  inventory      InventoryItem[]
  customProducts Product[]           @relation("StoreCustomProducts")
  vendorOrders   VendorOrder[]
  shipping       ShippingProvider[]
  settings       StoreSetting[]
  transactions   WalletTransaction[]
  withdrawals    WithdrawalRequest[]
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  password          String
  name              String?
  phone             String?
  address           String?
  city              String?
  role              Role           @default(USER)
  isVerified        Boolean        @default(false)
  verificationToken String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  store             Store?
  wishlist          WishlistItem[]
  orders            Order[]
}

model Order {
  id           String        @id @default(uuid())
  buyOrder     String        @unique
  userId       String?
  email        String
  name         String
  phone        String?
  address      String?
  city         String?
  notes        String?
  totalAmount  Decimal       @db.Decimal(10, 2)
  currencyCode String?       @default("CLP")
  exchangeRate Decimal?      @db.Decimal(10, 2)
  status       OrderStatus   @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  payment      Payment?
  user         User?         @relation(fields: [userId], references: [id])
  vendorOrders VendorOrder[]
}

model VendorOrder {
  id                 String           @id @default(uuid())
  orderId            String
  storeId            String
  shippingProviderId String
  shippingCost       Decimal          @default(0) @db.Decimal(10, 2)
  subtotal           Decimal          @default(0) @db.Decimal(10, 2)
  status             OrderStatus      @default(PENDING)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  order              Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store              Store            @relation(fields: [storeId], references: [id])
  shippingProvider   ShippingProvider @relation(fields: [shippingProviderId], references: [id])
  items              OrderItem[]
}

model OrderItem {
  id              String      @id @default(uuid())
  vendorOrderId   String
  productId       String
  inventoryItemId String?
  productName     String
  quantity        Int
  unitPrice       Decimal     @db.Decimal(10, 2)
  vendorOrder     VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @unique
  token           String        @unique
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(10, 2)
  authCode        String?
  cardLast4       String?
  paymentType     String?
  installments    Int?
  transactionDate DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order         @relation(fields: [orderId], references: [id])
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  FAILED
  NULLIFIED
}

model GlobalSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model Currency {
  id           String   @id @default(uuid())
  code         String   @unique // e.g., "CLP", "USD"
  name         String // e.g., "Peso Chileno"
  symbol       String // e.g., "$"
  exchangeRate Decimal  @db.Decimal(10, 2)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ShippingProvider {
  id           String        @id @default(uuid())
  storeId      String?
  name         String // e.g. "CHILEXPRESS", "STARKEN"
  price        Decimal       @db.Decimal(10, 2)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  store        Store?        @relation(fields: [storeId], references: [id])
  vendorOrders VendorOrder[]

  @@unique([name, storeId])
}

model StoreSetting {
  id      String @id @default(uuid())
  storeId String
  key     String
  value   String
  store   Store  @relation(fields: [storeId], references: [id])

  @@unique([key, storeId])
}

model WalletTransaction {
  id        String          @id @default(uuid())
  storeId   String
  amount    Decimal         @db.Decimal(10, 2)
  type      TransactionType
  reference String?
  createdAt DateTime        @default(now())
  store     Store           @relation(fields: [storeId], references: [id])
}

enum TransactionType {
  SALE
  COMMISSION
  WITHDRAWAL
  REFUND
}

model WithdrawalRequest {
  id          String           @id @default(uuid())
  storeId     String
  amount      Decimal          @db.Decimal(10, 2)
  status      WithdrawalStatus @default(PENDING)
  bankDetails String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  store       Store            @relation(fields: [storeId], references: [id])
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}
