# ============================================================
# TapTrade Backend — Variables de Entorno
# ============================================================
# Copia este archivo como .env y reemplaza los valores placeholder
# con tus credenciales reales.
# ============================================================

# --- Base de Datos (PostgreSQL / Neon) ---
DATABASE_URL="postgresql://usuario:contraseña@host/base_de_datos?sslmode=verify-full&pgbouncer=true"

# --- Autenticación JWT ---
# Genera una clave segura con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="tu_clave_secreta_jwt_de_64_caracteres_aqui"

# --- Cloudflare Turnstile (CAPTCHA) ---
# Obtener en: https://dash.cloudflare.com/?to=/:account/turnstile
# Usa "1x0000000000000000000000000000000AA" para testing
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# --- Cloudinary (Gestión de Imágenes) ---
# Obtener en: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# --- Transbank Webpay Plus (Pasarela de Pagos) ---
# Documentación: https://www.transbankdevelopers.cl/
# Usar "integration" para pruebas, "production" para producción
WEBPAY_ENV="integration"
# Solo necesarios en producción (credenciales entregadas por Transbank):
# WEBPAY_COMMERCE_CODE="597055555532"
# WEBPAY_API_KEY="tu_api_key_de_transbank"

# --- URLs de la Aplicación ---
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3001/api/v1"

# --- JustTCG API (Sincronización Riftbound) ---
# Obtener en: https://justtcg.com/
JUSTTCG_API_KEY="tcg_tu_api_key_aqui"

# --- SMTP (Envío de Correos) ---
# Compatible con cualquier proveedor SMTP: Resend, Gmail, SendGrid, etc.
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASS="re_tu_api_key_aqui"
SMTP_FROM='"Mi Tienda TCG" <no-reply@midominio.cl>'

# --- Chilexpress API (Seguimiento de Envíos en Vivo) ---
CHILEXPRESS_CLIENT_ID="tu_client_id_chilexpress"
CHILEXPRESS_CLIENT_SECRET="tu_client_secret_chilexpress"
CHILEXPRESS_SUBSCRIPTION_KEY="tu_subscription_key_chilexpress"

# --- Starken API (Seguimiento de Envíos en Vivo) ---
STARKEN_ENV="qa"
STARKEN_TRACKING_URL="https://apiqa.starken.cl/etrackingRest/resumenTrackingCargaRedestinacion"
STARKEN_API_KEY="tu_api_key_starken"
STARKEN_RUT="tu_rut_empresa_starken"
STARKEN_PASSWORD="tu_password_starken"
STARKEN_RUT_EMPRESA="tu_rut_empresa"


